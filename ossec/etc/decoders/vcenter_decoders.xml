<decoder name="vmware-vcenter">
  <program_name>^vpxd</program_name>
</decoder>

<decoder name="vcenter-syslog">
  <parent>vmware-vcenter</parent>
  <regex type="pcre2">^(\S+ \d+ \d+:\d+:\d+) (\S+) (\S+)</regex>
  <order>logtimestamp, esxi_host, process_name</order>
</decoder>

<decoder name="vcenter-syslog">
  <parent>vmware-vcenter</parent>
  <regex type="pcre2">\S+ \S+ \S+ \S+.*Successful login (\S+) from (\S+)</regex>
  <order>user, srcip</order>
</decoder>

<decoder name="vcenter-syslog">
  <parent>vmware-vcenter</parent>
  <regex type="pcre2">\S+ \S+ \S+ \S+.*User (\S+)@(\S+) logged </regex>
  <order>user, srcip</order>
</decoder>

<decoder name="vcenter-syslog">
  <parent>vmware-vcenter</parent>
  <regex type="pcre2">\S+ \S+ \S+ \S+.*Logout event by (\S+) from (\S+)</regex>
  <order>user, srcip</order>
</decoder>

<decoder name="vcenter-syslog">
  <parent>vmware-vcenter</parent>
  <regex type="pcre2">\S+ \S+ \S+ \S+.*Failed login (\S+) from (\S+)</regex>
  <order>user, srcip</order>
</decoder>

