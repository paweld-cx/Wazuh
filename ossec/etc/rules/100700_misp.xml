<group name="misp,">
 
  <rule id="100720" level="10">
    <field name="integration">misp</field>
    <match>misp</match>
    <description>MISP Events</description>
    <options>no_full_log</options>
  </rule>
 
  <rule id="100721" level="5">
    <if_sid>100720</if_sid>
    <field name="misp.error">\.+</field>
    <description>MISP - Error connecting to API</description>
    <options>no_full_log</options>
    <group>misp_error,</group>
  </rule>
 
  <rule id="100722" level="12">
    <field name="misp.category">\.+</field>
    <list field="misp.value" lookup="not_match_key">etc/lists/whitelistMISP</list>
    <description>MISP IoC - Cat:$(misp.category), Attr: $(misp.value)</description>
    <options>no_full_log</options>
    <group>misp_alert,</group>
   </rule>

</group>
